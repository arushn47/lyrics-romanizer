{
  "manifest_version": 3,
  "name": "tunescript",
  "version": "1.2.0",
  "description": "Romanize and translate Tamil, Malayalam & other Indian lyrics on Spotify & YT Music",
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_ollama",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://music.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://lrclib.net/*",
    "https://api.mymemory.translated.net/*",
    "http://localhost:11434/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/cache.js",
        "shared/lrclib.js",
        "shared/gemini.js",
        "shared/transliterate.js",
        "shared/translate-fallback.js",
        "content/detector.js",
        "content/panel.js",
        "content/sync.js",
        "content/main.js",
        "content/spotify.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content/ytmusic-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/cache.js",
        "shared/lrclib.js",
        "shared/gemini.js",
        "shared/transliterate.js",
        "shared/translate-fallback.js",
        "content/detector.js",
        "content/panel.js",
        "content/sync.js",
        "content/main.js",
        "content/ytmusic.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}