{
  "manifest_version": 3,
  "name": "TuneScript",
  "version": "1.3.2",
  "description": "Sing along to YouTube Music with readable Roman lyrics and English translations. Uses your Gemini API key.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://lrclib.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content/ytmusic-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/request.js",
        "shared/diagnostics.js",
        "shared/cache.js",
        "shared/performance.js",
        "shared/lyrics.js",
        "shared/matching.js",
        "shared/lrclib.js",
        "shared/providers.js",
        "shared/gemini.js",
        "shared/script-comparison.js",
        "content/detector.js",
        "content/panel.js",
        "content/player-clock.js",
        "content/sync.js",
        "content/main.js",
        "content/ytmusic.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
